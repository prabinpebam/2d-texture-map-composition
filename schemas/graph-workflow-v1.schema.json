{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://textureflow.local/schemas/graph-workflow-v1.schema.json",
  "type": "object",
  "required": ["format", "formatVersion", "project", "nodes", "edges"],
  "properties": {
    "format": { "const": "textureflow-workflow" },
    "formatVersion": { "const": "1.0.0" },
    "project": {
      "type": "object",
      "required": ["id", "name", "viewport"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "viewport": {
          "type": "object",
          "required": ["x", "y", "zoom"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "zoom": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "maxItems": 20000,
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "minimum": 180, "maximum": 640 },
        "height": { "type": "number", "minimum": 96, "maximum": 1200 }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label",
        "position",
        "size",
        "zIndex",
        "bypassed",
        "muted",
        "locked"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/point" },
        "size": { "$ref": "#/$defs/size" },
        "zIndex": { "type": "integer" },
        "bypassed": { "type": "boolean" },
        "muted": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "parameters": { "type": "object" }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "sourceNodeId",
        "sourcePortId",
        "targetNodeId",
        "targetPortId",
        "order"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceNodeId": { "type": "string", "minLength": 1 },
        "sourcePortId": { "type": "string", "minLength": 1 },
        "targetNodeId": { "type": "string", "minLength": 1 },
        "targetPortId": { "type": "string", "minLength": 1 },
        "order": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
